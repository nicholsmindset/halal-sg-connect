# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase (for Netlify Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
VITE_APP_NAME=Halal SG Connect
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Production Settings
NODE_ENV=production
VITE_APP_URL=https://your-domain.netlify.app

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PREMIUM_FEATURES=true

# Optional: External APIs
SINGAPORE_ONEMAP_API_KEY=your_onemap_api_key
VITE_MAPS_API_KEY=your-maps-api-key-here

# Optional: Email Service (for contact forms)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com

# Optional: Analytics & Monitoring
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
VITE_SENTRY_DSN=your-sentry-dsn-here